venv/
data/*
!data/*.yaml
# Agent approval mail-drop: CI publishes pending_deploy.json to the agent-approvals
# branch (via git add -f) and the local daemon fetches it read-only. Keep the dir in
# the repo via .gitkeep but ignore all runtime artifacts (requests, reports, state).
!data/approval_queue/
data/approval_queue/*
!data/approval_queue/.gitkeep
!data/*.tsv
!data/datasets.lock
!data/holdout/
data/holdout/*.jsonl
!data/benchmark/
data/benchmark/*.jsonl
!data/canary/
data/canary/*.json
!data/aggregated/
data/aggregated/*.jsonl
data/aggregated/*.json
!data/staging/
data/staging/*.jsonl
data/staging/*.json
!data/harvest/
data/harvest/known_datasets.txt
!data/scraped/
data/scraped/*.txt
data/scraped/static/
!data/raw/
data/raw/*.csv
!data/raw/harvested_samples.csv
# Threat-intel snapshots dir: ignore runtime snapshot artifacts but keep the
# human-reviewed MITRE ATLAS -> Na0S mapping committed (the taxonomy-aware
# harvester and its tests depend on this default mapping existing in a clone).
!data/threat_intel_snapshots/
data/threat_intel_snapshots/*
!data/threat_intel_snapshots/atlas_to_na0s_mapping.yaml
__pycache__/
.DS_Store
*.egg-info/
dist/
build/
.hypothesis/
*.db
src/data/fingerprints.db-shm
src/data/fingerprints.db-wal

# Build & test artifacts
*.pyc
.coverage
htmlcov/

# Local runtime logs (agent daemon, etc.)
logs/

# Environment
.env
.venv*/

# Model backups (created by deploy_model.py)
*.bak

# DVC — ignore the data cache, but keep the .dvc/ config directory
# and pointer files (*.dvc) so the repo knows it's a DVC project.
/.dvc/cache
/.dvc/tmp
!.dvc/
!*.dvc

# Claude Code config
.claude/
data/raw/**/

# Runtime logs & ad-hoc scratch/audit dirs (never commit)
logs/
.tmp_claude/
.tmp_task/
.tmp_audit/
.tmpaudit/
.audit_tmp/
